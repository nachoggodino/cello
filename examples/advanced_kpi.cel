// Advanced KPI workbook using named refs, slices, cross-sheet refs and !! alias

@sheet RawData [csv]
date,region,agent,amount,units
2026-01-01,Madrid,Ana,1200,4
2026-01-01,Barcelona,Luis,980,3
2026-01-02,Madrid,Sara,1420,5
2026-01-02,Valencia,Pedro,760,2
2026-01-03,Madrid,Ana,1660,6
2026-01-03,Barcelona,Luis,1100,4
2026-01-04,Valencia,Pedro,920,3
2026-01-04,Madrid,Sara,1510,5
2026-01-05,Barcelona,Luis,1340,5
2026-01-05,Madrid,Ana,1720,6

@sheet KPIs

@header | Metric | Value |
| ## Revenue KPIs | < |
| Total revenue | =SUM(!!amount) |
| Total units | =SUM(!!units) |
| Avg ticket | =SUM(!!amount)/SUM(!!units) |
| Best single sale | =MAX(!!amount) |
| First 5 rows revenue | =SUM(!!amount[2:6]) |

@sheet Regions

@header | Region | Revenue[€][2d] | Units[0d] | Avg_ticket[€][2d] | Target[€][0d] | Variance[€][2d] | Attainment[%][1d] |
| Madrid | =SUMIF(RawData!region,"Madrid",RawData!amount) | =SUMIF(RawData!region,"Madrid",RawData!units) | =Revenue/Units | 7200 | =Revenue-Target | =Revenue/Target |
| Barcelona | =SUMIF(RawData!region,"Barcelona",RawData!amount) | =SUMIF(RawData!region,"Barcelona",RawData!units) | =Revenue/Units | 3900 | =Revenue-Target | =Revenue/Target |
| Valencia | =SUMIF(RawData!region,"Valencia",RawData!amount) | =SUMIF(RawData!region,"Valencia",RawData!units) | =Revenue/Units | 1800 | =Revenue-Target | =Revenue/Target |
[bold][bg:#f3f4f6] | ## TOTAL | =SUM(Revenue) | =SUM(Units) | =SUM(Revenue)/SUM(Units) | =SUM(Target) | =SUM(Variance) | =SUM(Revenue)/SUM(Target) |

@sheet Agents

@header | Agent | Revenue[€][2d] | Units[0d] | Avg_ticket[€][2d] |
| Ana | =SUMIF(RawData!agent,"Ana",RawData!amount) | =SUMIF(RawData!agent,"Ana",RawData!units) | =Revenue/Units |
| Luis | =SUMIF(RawData!agent,"Luis",RawData!amount) | =SUMIF(RawData!agent,"Luis",RawData!units) | =Revenue/Units |
| Sara | =SUMIF(RawData!agent,"Sara",RawData!amount) | =SUMIF(RawData!agent,"Sara",RawData!units) | =Revenue/Units |
| Pedro | =SUMIF(RawData!agent,"Pedro",RawData!amount) | =SUMIF(RawData!agent,"Pedro",RawData!units) | =Revenue/Units |
