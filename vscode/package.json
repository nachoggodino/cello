{
  "name": "cello-vscode",
  "displayName": "Cello",
  "description": "Syntax highlighting, formatting, file icons, and live HTML previews for Cello .cel workbooks.",
  "version": "0.0.1",
  "publisher": "nachoggodino",
  "license": "GPL-3.0-only",
  "type": "module",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/nachoggodino/cello.git",
    "directory": "vscode"
  },
  "bugs": {
    "url": "https://github.com/nachoggodino/cello/issues"
  },
  "homepage": "https://github.com/nachoggodino/cello#readme",
  "galleryBanner": {
    "color": "#e7662f",
    "theme": "dark"
  },
  "pricing": "Free",
  "categories": [
    "Programming Languages",
    "Visualization",
    "Formatters",
    "Other"
  ],
  "keywords": [
    "cello",
    "spreadsheet",
    "preview",
    "syntax",
    "format",
    "cel",
    "csv",
    "formula",
    "table",
    "workbook"
  ],
  "engines": {
    "vscode": "^1.96.0"
  },
  "activationEvents": [
    "onLanguage:cel",
    "onCommand:cello.openPreview",
    "onCommand:cello.openPreviewToSide",
    "onCommand:cello.formatDocument"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "typecheck": "tsc -p . --noEmit",
    "compile": "npm run typecheck && esbuild src/extension.ts --bundle --platform=node --format=esm --target=node20 --external:vscode --outfile=dist/extension.js",
    "watch": "tsc -w -p .",
    "test": "vitest run",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "contributes": {
    "languages": [
      {
        "id": "cel",
        "aliases": [
          "Cello",
          "cel"
        ],
        "extensions": [
          ".cel"
        ],
        "configuration": "./syntaxes/cel.language-configuration.json",
        "icon": {
          "light": "./media/cello-file.svg",
          "dark": "./media/cello-file.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "cel",
        "scopeName": "source.cel",
        "path": "./syntaxes/cel.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "cello.openPreview",
        "title": "Cello: Open Preview",
        "category": "Cello",
        "icon": "$(preview)"
      },
      {
        "command": "cello.openPreviewToSide",
        "title": "Cello: Open Preview to the Side",
        "category": "Cello",
        "icon": "$(open-preview)"
      },
      {
        "command": "cello.formatDocument",
        "title": "Cello: Format Document",
        "category": "Cello",
        "icon": "$(symbol-keyword)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "cello.openPreviewToSide",
          "when": "resourceLangId == cel",
          "group": "navigation"
        },
        {
          "command": "cello.formatDocument",
          "when": "resourceLangId == cel",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "cello.formatDocument",
          "when": "resourceLangId == cel",
          "group": "1_modification"
        },
        {
          "command": "cello.openPreview",
          "when": "resourceLangId == cel",
          "group": "navigation"
        },
        {
          "command": "cello.openPreviewToSide",
          "when": "resourceLangId == cel",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "cello.formatDocument",
          "when": "resourceExtname == .cel",
          "group": "navigation@1"
        },
        {
          "command": "cello.openPreviewToSide",
          "when": "resourceExtname == .cel",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "cello.openPreview",
          "when": "editorLangId == cel"
        },
        {
          "command": "cello.openPreviewToSide",
          "when": "editorLangId == cel"
        },
        {
          "command": "cello.formatDocument",
          "when": "editorLangId == cel"
        }
      ]
    },
    "configuration": {
      "title": "Cello",
      "properties": {
        "cello.preview.debounceMs": {
          "type": "number",
          "default": 250,
          "minimum": 0,
          "maximum": 5000,
          "description": "Delay in milliseconds before refreshing a live Cello preview after edits."
        }
      }
    }
  },
  "devDependencies": {
    "@nachoggodino/cello": "^0.1.1",
    "@types/node": "^22.10.7",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.2.2",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
